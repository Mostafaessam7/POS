{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pos-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project", "src/Hosts/POS.Api",
        "-c", "Release",
