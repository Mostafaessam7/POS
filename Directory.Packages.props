<Project>
  <!-- Central Package Management: one version per package, solution-wide.
       Version drift between projects is a real and tedious source of bugs. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <!-- ToTable, HasColumnName, HasFilter, HasDefaultSchema and friends live in
         .Relational, not in the core package. Module projects that own Fluent API
         configuration need it explicitly; hosts get it via the provider package. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.19" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>
  <ItemGroup Label="Security">
    <!-- Argon2id password hashing (ADR 012). The `using` is
         Konscious.Security.Cryptography; the PACKAGE is the .Argon2 suffix. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- Bearer validation is NOT in the ASP.NET Core shared framework; it ships
         separately and must track the runtime's major version. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
  </ItemGroup>
  <ItemGroup Label="Terminal Agent">
    <!-- SQLite is the terminal's local store; SQL Server is cloud-only. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup Label="Caching">
    <PackageVersion Include="StackExchange.Redis" Version="2.8.16" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="8.0.0" />
    <!-- OpenTelemetry ships in two families with independent version streams:
         core/exporters (opentelemetry-dotnet) and instrumentation (…-contrib). They are
         NOT interchangeable. 1.15.3 exists for the exporter but never existed for the
         instrumentation packages, which went 1.15.0 -> 1.15.1 -> 1.16.0; asking for
         1.15.3 there produces NU1603 and, with TreatWarningsAsErrors, a failed restore.

         1.16.0 is current in BOTH families, so aligning on it keeps the two consistent
         and stays above the 1.15.3 patch floor for CVE-2026-42191 / GHSA-4625-4j76-fww9
         (moderate): with OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY=disk and no explicit retry
         directory, the exporter fell back to Path.GetTempPath(), allowing local blob
         injection into the telemetry stream on a multi-user host.

         Every version in this file was chosen without a package feed and is unverified
         until restore succeeds (ADR 056). -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <!-- Instrumentation.Http and Instrumentation.EntityFrameworkCore were declared here
         but referenced by no project, so their versions could never be validated by a
         restore. Removed rather than left as unverifiable guesses; add them back with a
         real version at the point something actually needs them. -->
  </ItemGroup>
  <ItemGroup Label="Resilience">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.0.0" />
    <PackageVersion Include="Respawn" Version="6.2.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.0.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.11.4" />
    <!-- Shouldly, not FluentAssertions.
         FluentAssertions 8+ requires a paid Xceed licence for commercial use;
         7.x remains Apache 2.0 but is frozen. Shouldly is MIT with no such trap.
         Alternative if you prefer the FluentAssertions syntax: AwesomeAssertions
         (community fork, Apache 2.0). See docs/adr/010-assertion-library.md -->
    <PackageVersion Include="Shouldly" Version="4.2.1" />
  </ItemGroup>

  <!-- Transitive pins closing High-severity advisories that CI flags. Both arrive through other
       packages, so neither can be fixed by bumping a direct reference; central transitive pinning
       is enabled above, which is what makes these effective. -->
  <ItemGroup>
    <!-- GHSA-2m69-gcr7-jv3q. Pulled in by Microsoft.EntityFrameworkCore.Sqlite in
         POS.TerminalAgent, which resolved 2.1.10. 2.1.13 is the patched release on the same
         line - 3.x is a major jump with no advisory reason to take it here. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />

    <!-- GHSA-q939-rpr3-3284. Pulled in by Testcontainers.MsSql in POS.IntegrationTests, which
         resolved 2023.0.0. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
