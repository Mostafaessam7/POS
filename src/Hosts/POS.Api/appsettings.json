{
  "ConnectionStrings": {
    "Pos": "Server=localhost;Database=PosPlatform;Trusted_Connection=true;TrustServerCertificate=true;Encrypt=false",
    "Redis": ""
  },
  "Identity": {
    "Issuer": "https://api.pos.example",
    "Audience": "pos-terminals",
    "SigningKey": ""
  },
  "Provisioning": {
    "Enabled": false,
    "RootApiKey": ""
  },
  "Cors": {
    "//": "Empty by design — refuse closed. No browser client exists yet; add an origin here explicitly when one does.",
    "AllowedOrigins": []
  },
  "Api": {
    "//": "Off by default outside Development — a schema/docs browser is reconnaissance information, exposed only as an explicit choice.",
    "EnableOpenApiDocs": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
